<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{3159C752-D70A-4685-B575-E3099AFA5ADA}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>CustomFonts</RootNamespace>
    <AssemblyName>CustomFonts</AssemblyName>
    <RimWorldVersion Condition="'$(RimWorldVersion)' == '' and $([System.String]::Copy('$(Configuration)').StartsWith('Release '))">$([System.String]::Copy('$(Configuration)').Substring(8))</RimWorldVersion>
    <RimWorldVersion Condition="'$(RimWorldVersion)' == ''">1.6</RimWorldVersion>
    <ExpectedEngine Condition="$([MSBuild]::VersionLessThan('$(RimWorldVersion)', '1.7'))">Unity</ExpectedEngine>
    <ExpectedEngine Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(RimWorldVersion)', '1.7'))">Waylith</ExpectedEngine>
    <Engine>$(ExpectedEngine)</Engine>
    <TargetFramework Condition="'$(Engine)' == 'Unity'">net472</TargetFramework>
    <TargetFramework Condition="'$(Engine)' == 'Waylith'">net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameDir Condition="'$(GameDir)' == ''">$(STEAM_APPS)/common/RimWorld</GameDir>
    <HarmonyUnityFolder Condition="Exists('$(MSBuildProjectDirectory)/../../packages/HarmonyMod/1.6/Assemblies/0Harmony.dll')">1.6</HarmonyUnityFolder>
    <HarmonyUnityFolder Condition="'$(HarmonyUnityFolder)' == ''">Current</HarmonyUnityFolder>
    <FileAlignment>512</FileAlignment>
    <IsPublishable>false</IsPublishable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>../../Assemblies</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release 1.4|AnyCPU' ">
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <OutputPath>../../1.4/Assemblies/</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release 1.5|AnyCPU' ">
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <OutputPath>../../1.5/Assemblies/</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release 1.6|AnyCPU' ">
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <OutputPath>../../1.6/Assemblies/</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="$([System.String]::Copy('$(Configuration)').StartsWith('Release '))">
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
    <OutputPath>../../$(RimWorldVersion)/Assemblies/</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Engine)' == 'Waylith'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>$(DefineConstants);WAYLITH</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Shared/**/*.cs" />
    <EmbeddedResource Include="Shared/BundledFonts.tsv" LogicalName="CustomFonts.BundledFonts.tsv" />
    <Compile Include="Engines/$(Engine)/**/*.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(Engine)' == 'Waylith'">
    <Reference Include="Assembly-CSharp" HintPath="$(GameDir)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="UnityStubs" HintPath="$(GameDir)/UnityStubs.dll" Private="false" />
    <Reference Include="Brutal.ImGui" HintPath="$(GameDir)/Brutal.ImGui.dll" Private="false" />
    <Reference Include="Brutal.Core.Common" HintPath="$(GameDir)/Brutal.Core.Common.dll" Private="false" />
    <Reference Include="Brutal.Core.Numerics" HintPath="$(GameDir)/Brutal.Core.Numerics.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="../../packages/HarmonyMod/1.7/Assemblies/0Harmony.dll" Private="false" />
  </ItemGroup>
  <Choose>
    <When Condition="'$(Engine)' == 'Waylith'" />
    <When Condition=" '$(RimWorldVersion)'=='1.4' ">
      <ItemGroup>
        <Reference Include="0Harmony, Version=2.2.2.0, Culture=neutral, processorArchitecture=MSIL">
          <HintPath>$(ProjectDir)/../../packages/HarmonyMod/1.4/Assemblies/0Harmony.dll</HintPath>
          <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.TextCoreModule">
          <HintPath>$(GameDir)/$(STEAM_OS)/Managed/UnityEngine.TextCoreModule.dll</HintPath>
          <Private>False</Private>
        </Reference>
      </ItemGroup>
    </When>
    <When Condition=" '$(RimWorldVersion)'=='1.5' ">
      <ItemGroup>
        <Reference Include="0Harmony, Version=2.3.3.0, Culture=neutral, processorArchitecture=MSIL">
          <HintPath>$(ProjectDir)/../../packages/HarmonyMod/1.5/Assemblies/0Harmony.dll</HintPath>
          <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.TextCoreModule">
          <HintPath>$(GameDir)/$(STEAM_OS)/Managed/UnityEngine.TextCoreModule.dll</HintPath>
          <Private>False</Private>
        </Reference>
      </ItemGroup>
    </When>
    <When Condition=" '$(RimWorldVersion)'=='1.6' ">
      <ItemGroup>
        <!-- Harmony 3 moved the Unity library from Current to 1.6. Keep supporting both
             layouts; do not bind the Unity build to the .NET 10 library in 1.7. -->
        <Reference Include="0Harmony">
          <HintPath>$(ProjectDir)/../../packages/HarmonyMod/$(HarmonyUnityFolder)/Assemblies/0Harmony.dll</HintPath>
          <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.TextCoreFontEngineModule">
          <HintPath>$(GameDir)/$(STEAM_OS)/Managed/UnityEngine.TextCoreFontEngineModule.dll</HintPath>
          <Private>False</Private>
        </Reference>
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup>
        <Reference Include="0Harmony, Culture=neutral, processorArchitecture=MSIL">
          <HintPath>$(ProjectDir)/../../packages/HarmonyMod/$(HarmonyUnityFolder)/Assemblies/0Harmony.dll</HintPath>
          <Private>False</Private>
        </Reference>
      </ItemGroup>
    </Otherwise>
  </Choose>
  <ItemGroup Condition="'$(Engine)' == 'Unity'">
    <EmbeddedResource Include="Engines/Unity/FontTemplate.bin" LogicalName="CustomFonts.FontTemplate.bin" />
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)/$(STEAM_OS)/Managed/Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" />
    <Reference Include="System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" />
    <Reference Include="System.Core, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089"/>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GameDir)/$(STEAM_OS)/Managed/Unity.TextMeshPro.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameDir)/$(STEAM_OS)/Managed/UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(GameDir)/$(STEAM_OS)/Managed/UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)/$(STEAM_OS)/Managed/UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameDir)/$(STEAM_OS)/Managed/UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameDir)/$(STEAM_OS)/Managed/UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameDir)/$(STEAM_OS)/Managed/UnityEngine.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="packages.config" />
  </ItemGroup>
  <Target Name="RemoveLegacyFontLibrary" AfterTargets="Build">
    <Delete Files="$(OutputPath)AssetsTools.NET.dll;$(OutputPath)AssetsTools.NET.xml;$(OutputPath)AssetsTools.NET.pdb" />
  </Target>
  <Target Name="ValidateEngineSelection" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Engine)' != '$(ExpectedEngine)'"
           Text="RimWorld $(RimWorldVersion) requires $(ExpectedEngine). The Engine property cannot override the version boundary." />
    <Error Condition="'$(RequestedEngine)' != '' and '$(RequestedEngine)' != '$(Engine)'"
           Text="RimWorld $(RimWorldVersion) requires $(Engine), but the requested build is $(RequestedEngine). Use build_version for automatic engine selection." />
  </Target>
</Project>
