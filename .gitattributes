# Auto detect text files and perform LF normalization
* text=auto eol=lf

*.cs text diff=csharp eol=crlf
*.cshtml text diff=html eol=crlf
*.csx text diff=csharp eol=crlf
*.sln text eol=crlf
*.csproj text eol=crlf
*.[dD][lL][lL] filter=lfs diff=lfs merge=lfs -text
*.[pP][dD][bB] filter=lfs diff=lfs merge=lfs -text
*.[tT][tT][fF] filter=lfs diff=lfs merge=lfs -text
*.[tT][tT][cC] filter=lfs diff=lfs merge=lfs -text
*.[oO][tT][fF] filter=lfs diff=lfs merge=lfs -text
*.[oO][tT][cC] filter=lfs diff=lfs merge=lfs -text
*.[wW][oO][fF][fF] filter=lfs diff=lfs merge=lfs -text
*.[wW][oO][fF][fF]2 filter=lfs diff=lfs merge=lfs -text
*.[eE][oO][tT] filter=lfs diff=lfs merge=lfs -text
*.bin binary

# Preserve the vendored upstream license bytes (including its original whitespace).
Examples/ABeeZeeFontPack/Fonts/OFL.txt -text -whitespace
