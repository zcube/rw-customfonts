<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Source/CustomFonts/Engines/Waylith/OpenTypeNames.cs" Link="OpenTypeNames.cs" />
    <Compile Include="../../Source/CustomFonts/Engines/Waylith/FontFiles.cs" Link="FontFiles.cs" />
    <Compile Include="../../Source/CustomFonts/Engines/Waylith/AdditionalFontRoots.cs" Link="AdditionalFontRoots.cs" />
    <Compile Include="../../Source/CustomFonts/Engines/Waylith/UnicodeScalars.cs" Link="UnicodeScalars.cs" />
    <Compile Include="../../Source/CustomFonts/Engines/Waylith/FontCoverage.cs" Link="FontCoverage.cs" />
    <Compile Include="../../Source/CustomFonts/Engines/Waylith/FontCollections.cs" Link="FontCollections.cs" />
  </ItemGroup>
  <PropertyGroup Condition="Exists('$(GameDir)/AssetsTools.NET.dll')">
    <DefineConstants>$(DefineConstants);BUNDLE_TESTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(GameDir)/AssetsTools.NET.dll')">
    <Reference Include="AssetsTools.NET" HintPath="$(GameDir)/AssetsTools.NET.dll" />
    <Compile Include="../../Source/CustomFonts/Engines/Waylith/BundledFontReader.cs" Link="BundledFontReader.cs" />
  </ItemGroup>
</Project>
